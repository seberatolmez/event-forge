{
  "type": "record",
  "name": "InventoryReserved",
  "namespace": "com.eventforge.contracts.inventory",
  "doc": "InventoryReserved domain event (version 1) using the common EventForge envelope.",
  "fields": [
    {
      "name": "eventId",
      "type": {"type": "string", "logicalType": "uuid"}
    },
    {
      "name": "eventType",
      "type": "string"
    },
    {
      "name": "eventVersion",
      "type": "int"
    },
    {
      "name": "occurredAt",
      "type": {"type": "long", "logicalType": "timestamp-millis"}
    },
    {
      "name": "aggregateType",
      "type": "string"
    },
    {
      "name": "aggregateId",
      "type": {"type": "string", "logicalType": "uuid"}
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "InventoryReservedPayload",
        "fields": [
          {"name": "reservationId", "type": {"type": "string", "logicalType": "uuid"}},
          {"name": "orderId", "type": {"type": "string", "logicalType": "uuid"}},
          {"name": "productId", "type": {"type": "string", "logicalType": "uuid"}},
          {"name": "quantity", "type": "int"}
        ]
      }
    }
  ]
}
